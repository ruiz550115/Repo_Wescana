  <DUT Name="ST_AxisData" Id="{ad2bda75-b80b-473d-b8a2-2c60a7df7f41}">
    <Declaration><![CDATA[TYPE ST_AxisData :
STRUCT
	
	// Control Bits
	xEnable       : BOOL;
	xReset        : BOOL;
	xMoveAbs      : BOOL;
	xStop		  :	Bool;
	lrPosition    : LREAL;
	lrVelocity    : LREAL 	:= 100.0; // Default velocity
	
	
	// Stauts Bits
	
	xReady         : BOOL;
	xBusy          : BOOL;
	xDone          : BOOL;
	xError         : BOOL;
	udiErrorID     : UDINT;
	lrActPosition  : LREAL;
	
END_STRUCT
END_TYPE
]]></Declaration>
