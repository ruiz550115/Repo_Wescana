<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_Intjig" Id="{402d25f5-83e6-430e-b6f6-01ea739e6627}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	// Set this to ANY arbitrary integer. The entire PLC system scales to it automatically.
	MAX_AXES : INT := 36; 
END_VAR

VAR_GLOBAL
	// System structures scale directly with the constant
	astAxisData    : ARRAY[1..GVL_Intjig.MAX_AXES] OF stAxisData;
	afbAxisCntrl   : ARRAY[1..GVL_Intjig.MAX_AXES] OF fbAxisCntrl;
	
	// A flat pointer loop array used to execute your cyclic blocks
	aLoopAxes      : ARRAY[1..50] OF POINTER TO AXIS_REF;

	// Single independent variables. The precompiler binds these 100% reliably.
	{attribute 'TcNcAxis' := 'Axis1'}  Axis01 : AXIS_REF;
	{attribute 'TcNcAxis' := 'Axis2'}  Axis02 : AXIS_REF;
	{attribute 'TcNcAxis' := 'Axis3'}  Axis03 : AXIS_REF;
